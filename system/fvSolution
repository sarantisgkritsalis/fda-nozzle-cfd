FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-06;
        relTol          0.05;
        smoother        GaussSeidel;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0;
    }

    // nOuterCorrectors 1 means every timestep is the "final" outer
    // iteration, so pimpleFoam/kOmegaSST look up these *Final entries
    // for U, k and omega (not just p) -- all identical to their base
    // entries above, just with relTol forced to 0.
    "(U|k|omega)Final"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-06;
        relTol          0;
    }
}

// Step 3 (pimpleFoam): nOuterCorrectors 1 makes this PISO-equivalent --
// one momentum-predictor + nCorrectors pressure-correction pass per
// timestep, no outer-loop under-relaxation needed since every timestep
// is already the "final" (and only) outer iteration, and deltaT is kept
// small by hand (see controlDict) rather than relying on outer
// iterations to absorb a large timestep.
PIMPLE
{
    nOuterCorrectors           1;
    nCorrectors                2;
    nNonOrthogonalCorrectors   1;
    momentumPredictor          yes;
}


