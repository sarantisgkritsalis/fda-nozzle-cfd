FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Coarse first-pass mesh: castellate + snap + boundary layers on nozzleWall,
// sized to target y+ ~ 30 at the throat (highest wall shear, smallest local
// medial-axis distance -- see addLayersControls below).
castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    fda_nozzle_wall.stl
    {
        type triSurfaceMesh;
        name nozzleWall;
    }
}

castellatedMeshControls
{
    maxLocalCells       100000;
    maxGlobalCells      1000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 2;

    features
    (
        {
            file    "fda_nozzle_wall.eMesh";
            level   1;
        }
    );

    refinementSurfaces
    {
        nozzleWall
        {
            // Coarse: single uniform refinement level against the background
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
    }

    // Inside the inlet stub, well away from the wall and any refined region.
    locationInMesh (0 0 0.01);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch            3;
    tolerance               2.0;
    nSolveIter              30;
    nRelaxIter              5;
    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

addLayersControls
{
    relativeSizes   true;
    layers
    {
        nozzleWall
        {
            nSurfaceLayers 3;
        }
    }

    // Sized off the throat: local surface cell size there is ~1 mm (background
    // 2 mm, refinement level 1), and the throat friction velocity at throat
    // Re = 6500 (see 0/U) gives y+ = 30 at ~0.28 mm wall distance. So a first
    // layer at 0.3x the local cell size lands right at y+ ~ 30 in the throat.
    // Kept to 3 layers (not more) because the throat is only 4 mm in
    // diameter -- maxThicknessToMedialRatio below caps total layer stack at
    // 30% of local wall-to-centerline distance (~0.6 mm at the throat), so a
    // taller stack would just get squeezed back down by snappyHexMesh anyway.
    // Away from the throat (larger pipe, lower shear) the same absolute
    // first-layer thickness gives a smaller y+ -- that's expected and
    // checked in the next step, not something this mesh alone can fix
    // everywhere given the flow separation downstream of the sudden
    // expansion.
    firstLayerThickness    0.3;
    expansionRatio          1.2;
    minThickness            0.1;
    nGrow                   0;
    featureAngle            60;
    slipFeatureAngle        30;
    nRelaxIter              3;
    nSmoothSurfaceNormals   1;
    nSmoothNormals          3;
    nSmoothThickness        10;
    maxFaceThicknessRatio   0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   0;
    nLayerIter              50;
}

meshQualityControls
{
    #include "meshQualityDict"

    nSmoothScale    4;
    errorReduction  0.75;
}

mergeTolerance 1e-6;

