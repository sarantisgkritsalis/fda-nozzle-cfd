FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Coarse first-pass mesh: castellate + snap + boundary layers on nozzleWall,
// sized to a low-Re target of y+ ~ 1 at the throat (highest wall shear,
// smallest local medial-axis distance -- see addLayersControls below).
castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    fda_nozzle_wall.stl
    {
        type triSurfaceMesh;
        name nozzleWall;
    }
}

castellatedMeshControls
{
    maxLocalCells       100000;
    maxGlobalCells      1000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 2;

    features
    (
        {
            file    "fda_nozzle_wall.eMesh";
            level   1;
        }
    );

    refinementSurfaces
    {
        nozzleWall
        {
            // Coarse: single uniform refinement level against the background
            level (1 1);
            patchInfo
            {
                type wall;
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
    }

    // Inside the inlet stub, well away from the wall and any refined region.
    locationInMesh (0 0 0.01);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch            3;
    tolerance               2.0;
    nSolveIter              30;
    nRelaxIter              5;
    nFeatureSnapIter        10;
    implicitFeatureSnap     false;
    explicitFeatureSnap     true;
    multiRegionFeatureSnap  false;
}

addLayersControls
{
    relativeSizes   true;
    layers
    {
        nozzleWall
        {
            nSurfaceLayers 12;
        }
    }

    // Switched from a y+~30 wall-function target (Step 2 measured avg y+
    // 4.51, max 24.5 with that sizing -- undershooting 30 everywhere, and
    // dropping to viscous-sublayer levels away from the throat) to a
    // low-Re target of y+ ~ 1 at the throat instead. Rationale: the same
    // relative first-layer thickness gives a *smaller* y+ away from the
    // throat (lower shear), so "y+ in [30,300] everywhere" is a two-sided
    // target this geometry's shear range can't satisfy, while "y+ <~ 1-5
    // everywhere" is one-sided and only gets easier to satisfy away from
    // the throat.
    //
    // Local surface cell size at the throat is ~1 mm (background 2 mm,
    // refinement level 1, uniform across nozzleWall -- see
    // castellatedMeshControls above). Throat friction velocity (same
    // Blasius-type correlation used for the y+~30 estimate this replaces)
    // gives u_tau ~ 0.355 m/s at throat Re = 6500 (see 0/U), so
    // y+ = 1 at y = nu/u_tau = 3.314394e-06/0.355 ~ 0.0093 mm. A first
    // layer at 0.01x the local cell size (~0.01 mm) lands right at
    // y+ ~ 1 in the throat.
    // 12 layers at expansionRatio 1.2 sums to ~0.0093 mm * (1.2^12-1)/0.2
    // ~ 0.4 mm total stack, comfortably under the ~0.6 mm
    // maxThicknessToMedialRatio cap at the throat (see below) with margin
    // for snappyHexMesh's usual under-delivery (Step 1 achieved ~88% of
    // nominal thickness).
    firstLayerThickness    0.01;
    expansionRatio          1.2;
    minThickness            0.005;
    nGrow                   0;
    featureAngle            60;
    slipFeatureAngle        30;
    nRelaxIter              3;
    nSmoothSurfaceNormals   1;
    nSmoothNormals          3;
    nSmoothThickness        10;
    maxFaceThicknessRatio   0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle      90;
    nBufferCellsNoExtrude   0;
    nLayerIter              50;
}

meshQualityControls
{
    #include "meshQualityDict"

    nSmoothScale    4;
    errorReduction  0.75;
}

mergeTolerance 1e-6;

