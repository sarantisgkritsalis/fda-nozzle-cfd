// Extracts feature edges from the nozzle wall (contraction start/end,
// throat/expansion sharp step) so snappyHexMesh can snap to them.
fda_nozzle_wall.stl
{
    extractionMethod    extractFromSurface;

    extractFromSurfaceCoeffs
    {
        includedAngle   150;
    }

    writeObj            no;
}


