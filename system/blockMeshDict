FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Background hex mesh for snappyHexMesh. This is NOT the final mesh shape --
// it is a coarse box that snappyHexMesh castellates/snaps onto
// constant/triSurface/fda_nozzle_wall.stl.
//
// The wall STL (generated by scripts/generate_nozzle_geometry.py) is an
// OPEN tube: it has no end caps at the inlet/outlet. For snappyHexMesh's
// flood-fill (locationInMesh) to correctly separate "inside the nozzle"
// from "outside, in the surrounding box", this block's z-range is set to
// EXACTLY match the STL's z-range (0 to 0.162685 m: inlet stub + contraction
// + throat + sudden expansion + outlet stub, from generate_nozzle_geometry.py).
// The STL wall (a full revolve, no gaps) then separates inside from outside
// at every z-station, and any leftover "outside the wall, inside the box"
// corner regions are automatically discarded by snappyHexMesh because they
// are not connected to locationInMesh.
//
// x/y half-width (0.010 m) only needs to comfortably exceed the largest
// wall radius (R_PIPE = 0.006 m); the extra margin becomes disconnected
// corner cells that snappyHexMesh removes.

scale 1;

xMin -0.010;
xMax  0.010;
yMin -0.010;
yMax  0.010;
zMin  0.0;
zMax  0.162685;

// Coarse background cells, ~2 mm
nx   10;
ny   10;
nz   81;

vertices
(
    ($xMin $yMin $zMin)
    ($xMax $yMin $zMin)
    ($xMax $yMax $zMin)
    ($xMin $yMax $zMin)
    ($xMin $yMin $zMax)
    ($xMax $yMin $zMax)
    ($xMax $yMax $zMax)
    ($xMin $yMax $zMax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 3 2 1)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    surroundings
    {
        type patch;
        faces
        (
            (0 1 5 4)
            (2 3 7 6)
            (1 2 6 5)
            (3 0 4 7)
        );
    }
);

mergePatchPairs
(
);

