FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Kinematic pressure (p/rho), as used by incompressible solvers. Outlet is
// the reference (gauge 0); rho = 1056 kg/m^3 (constant/transportProperties)
// to redimensionalize for post-processing.

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    nozzleWall
    {
        type            zeroGradient;
    }
}


