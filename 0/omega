FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mixing-length estimate at the inlet (pipe diameter D_pipe = 12 mm):
//   l     = 0.07*D_pipe = 8.4e-04 m
//   omega = sqrt(k) / (Cmu^0.25 * l) = 79.65 1/s
// with k = 1.34295e-03 m^2/s^2 (see 0/k) and Cmu = 0.09.

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 79.65;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 79.65;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 79.65;
        value           uniform 79.65;
    }

    nozzleWall
    {
        type            omegaWallFunction;
        value           uniform 79.65;
    }
}


