FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// No turbulence intensity was measured/reported for the inlet in Hariharan
// et al. 2011 -- this uses a generic 5% intensity assumption for
// fully-developed pipe flow (I=0.05, U_inlet=0.598432 m/s):
//   k = 1.5*(I*U_inlet)^2 = 1.34295e-03 m^2/s^2

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1.34295e-03;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1.34295e-03;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 1.34295e-03;
        value           uniform 1.34295e-03;
    }

    nozzleWall
    {
        type            kqRWallFunction;
        value           uniform 1.34295e-03;
    }
}


