# OpenFOAM run artifacts
processor*/
*.foam
log.*
*.log
postprocessing/*
!postprocessing/.gitkeep

# OpenFOAM's own function-object output dir (capital P) -- distinct from
# the hand-curated postprocessing/ (lowercase) described in the README
postProcessing/

# ParaView state written next to the case if a session is saved there
VTK/

# Time directories generated during a run (keep only 0/)
[1-9]*/
[1-9]*.[0-9]*/

# Generated mesh (reproducible from system/*Dict + the STL -- see README)
constant/polyMesh/*
!constant/polyMesh/.gitkeep
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh

# OS/editor cruft
.DS_Store
*.swp
